}

// Village Data Models
model District {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String @unique
  nameMarathi String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  subDistricts SubDistrict[]
  
  @@map("districts")
}

model SubDistrict {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String @unique
  nameMarathi String
  districtId  String @db.ObjectId
  district    District @relation(fields: [districtId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  villages Village[]
  
  @@map("sub_districts")
}

model Village {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  nameMarathi   String
  subDistrictId String @db.ObjectId
  subDistrict   SubDistrict @relation(fields: [subDistrictId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("villages")
}


// ===== CAMPAIGN FORM SYSTEM MODELS =====

model CampaignForm {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  nameEn            String
  description       String?
  descriptionEn     String?
  formMetadata      Json   // {campaignName, year, formType}
  maxPossibleTotal  Float  @default(100)
  isActive          Boolean @default(true)
  isDefault         Boolean @default(false)
  createdBy         String? @db.ObjectId
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  sections          FormSection[]
  submissions       FormSubmission[]
  
  @@map("campaign_forms")
}

model FormSection {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  campaignFormId  String @db.ObjectId
  campaignForm    CampaignForm @relation(fields: [campaignFormId], references: [id])
  sectionId       Int    // For ordering/reference (1, 2, 3, etc.)
  title           String
  titleEn         String
  description     String?
  descriptionEn   String?
  order           Int    @default(0)
  maxMarks        Float  @default(0)
  isActive        Boolean @default(true)
  isRequired      Boolean @default(true)
  parentSectionId String? // For nested sections
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  items           FormItem[]
  itemValues       FormItemValue[]
  
  @@map("form_sections")
}

model FormItem {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  sectionId       String @db.ObjectId
  section         FormSection @relation(fields: [sectionId], references: [id])
  itemId          String // e.g., "1.1", "1.2", "1.3"
  itemType        String @default("simple") // "simple", "innovation"
  fieldName       String
  fieldNameEn     String
  description     String?
  actionType      String? // Description of action
  targets         Json?   // {below2000, between2000_5000, above5000}
  unit            String? // e.g., "मनुष्यदिन", "कामे"
  maxMarks        Float   @default(0)
  order           Int     @default(0)
  isActive        Boolean @default(true)
  isEditable      Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  itemValues      FormItemValue[]
  
  @@map("form_items")
}

model FormSubmission {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  campaignFormId  String @db.ObjectId
  campaignForm    CampaignForm @relation(fields: [campaignFormId], references: [id])
  subdomainId     String @db.ObjectId
  subdomain       Subdomain @relation(fields: [subdomainId], references: [id])
  basicInfo       Json   // {grampanchayatName, taluka, population, etc.}
  summary         Json   // {section totals, grand total}
  submittedBy     String @db.ObjectId
  status          String @default("draft") // draft, submitted, verified, approved
  totalMarks      Float  @default(0)
  totalMaxMarks   Float  @default(0)
  submittedAt     DateTime?
  verifiedAt      DateTime?
  verifiedBy      String? @db.ObjectId
  approvedAt      DateTime?
  approvedBy      String? @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  itemValues      FormItemValue[]
  
  @@map("form_submissions")
}

model FormItemValue {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  submissionId    String @db.ObjectId
  submission      FormSubmission @relation(fields: [submissionId], references: [id])
  itemId          String @db.ObjectId
  item            FormItem @relation(fields: [itemId], references: [id])
  sectionId       String @db.ObjectId
  section         FormSection @relation(fields: [sectionId], references: [id])
  target          Float? // उदिष्ट (legacy - will be replaced by targetValue)
  targetValue     Float? // Target Value (e.g., 100)
  targetPercentage Float? // Target Percentage (e.g., 80%)
  achieved        Float? // साध्य
  percentage      Float? // Auto-calculated
  marks           Float? // Auto-calculated
  innovations     Json?  // Array of innovations for innovation items
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("form_item_values")
}
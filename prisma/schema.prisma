// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model VillageInfo {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  // Village branding
  villageLogo     String? // Village logo URL
  villageName     String? // Custom village name for header
  villageNameEn   String? // Custom village name in English
  // Government branding strip (village-specific, overrides defaults)
  satyamevJayateLogoUrl String @default("/images/gov-logos/satyamev_jayate_logo.png")
  digitalIndiaLogoUrl    String @default("/images/gov-logos/digital-india.png")
  govDeptText            String @default("शासन महाराष्ट्र • ग्रामीण विकास विभाग")
  officialSiteText       String @default("अधिकृत ग्रामपंचायत संकेतस्थळ")
  // Additional dynamic sections (Marathi only)
  sectionOneTitle   String @default("")
  sectionOneBody    String @default("")
  sectionTwoTitle   String @default("")
  sectionTwoBody    String @default("")
  sectionThreeTitle String @default("")
  sectionThreeBody  String @default("")
  stats       Json   // Array of statistics
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("village_info")
}

model HistoryCard {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  gradient    String
  icon        String
  order       Int    @default(0)
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("history_cards")
}

model TimelineItem {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  year        String
  title       String
  titleEn     String
  description String
  descriptionEn String
  side        String @default("left") // left, right
  order       Int    @default(0)
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("timeline_items")
}

model Announcement {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  date        String
  description String
  fullDescription String?
  image       String
  category    String
  priority    String // high, medium, low
  status      String // active, completed, upcoming
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("announcements")
}

model CulturalHeritage {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  image       String
  category    String
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cultural_heritage")
}

model HeroImage {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl    String
  title       String?
  description String?
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_images")
}

model HomepageSettings {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  mainHeading String @default("आमच्या गावात स्वागत आहे")
  mainHeadingEn String @default("Welcome to Our Village")
  subtitle    String @default("एकत्रित विकास, सामाजिक न्याय आणि सुशासनाच्या मार्गावर प्रगतीशील गाव")
  subtitleEn  String @default("A progressive village on the path of integrated development, social justice and good governance")
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("homepage_settings")
}

model Program {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  date        DateTime
  time        String?
  location    String?
  category    String?
  imageUrl    String?
  status      String @default("upcoming") // upcoming, ongoing, completed
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programs")
}

model Gallery {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  type        String // photo, video
  mediaUrl    String // URL to the image or video file
  category    String?
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery")
}

model Facility {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameEn      String
  description String
  descriptionEn String
  category    String
  location    String?
  contactInfo String?
  workingHours String?
  isActive    Boolean @default(true)
  imageUrl    String?
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("facilities")
}

model Contact {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  type        String // office, person, department
  name        String
  nameEn      String
  designation String?
  designationEn String?
  phone       String?
  email       String?
  address     String?
  addressEn   String?
  workingHours String?
  workingHoursEn String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contacts")
}

model OfficeDetails {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  address     String
  addressEn   String
  phone       String
  email       String
  workingHours String
  workingHoursEn String

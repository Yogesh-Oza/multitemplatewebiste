  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("education_items")
}

model EnvironmentInitiative {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  type        String // tree, plastic-free, water, solar, waste
  typeEn      String
  metrics     Json   // Array of metrics: [{label: "Trees Planted", value: 500}]
  startDate   DateTime

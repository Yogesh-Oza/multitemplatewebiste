model MapSettings {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  embedUrl    String // Google Maps embed URL
  latitude    String?
  longitude   String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("map_settings")
}

model IncomeExpense {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  type        String // income, expense
  title       String
  titleEn     String
  description String
  descriptionEn String
  amount      Float
  category    String
  date        DateTime
  receiptUrl  String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("income_expense")
}

model Department {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameEn      String
  description String
  descriptionEn String
  head        String
  headEn      String
  phone       String?
  email       String?
  address     String?
  addressEn   String?
  workingHours String?
  workingHoursEn String?
  services     String[]
  servicesEn   String[]
  imageUrl    String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])

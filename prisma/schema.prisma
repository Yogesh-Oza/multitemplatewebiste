  subdomainId      String?                  @db.ObjectId
  subdomain        Subdomain?               @relation(fields: [subdomainId], references: [id])
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@map("education_health_facilities")
}

model AdminUser {
  id                        String        @id @default(auto()) @map("_id") @db.ObjectId
  username                  String        @unique
  email                     String        @unique
  password                  String
  role                      String        @default("admin") // super_admin, super_admin_viewer, admin, editor
  isActive                  Boolean       @default(true)
  subdomainId               String?       @db.ObjectId
  subdomain                 Subdomain?    @relation(fields: [subdomainId], references: [id])
  passwordResetToken        String?
  passwordResetTokenExpiry  DateTime?
  activityLogs              ActivityLog[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@map("admin_users")
}

model Subdomain {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  subdomain        String   @unique
  villageName      String
  villageNameEn    String
  contactPerson    String
  email            String
  phone            String
  address          String
  description      String?
  districtId       String?
  districtName     String?
  subDistrictId    String?
  subDistrictName  String?
  villageId        String?
  villageNameLocal String?
  adminUsername    String
  adminPassword    String
  status           String   @default("pending") // pending, active, suspended
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  adminUsers               AdminUser[]
  villageInfo              VillageInfo[]
  announcements            Announcement[]
  culturalHeritage         CulturalHeritage[]
  heroImages               HeroImage[]
  historyCards             HistoryCard[]
  timelineItems            TimelineItem[]
  programs                 Program[]

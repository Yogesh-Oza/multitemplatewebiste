// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model VillageInfo {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  // Additional dynamic sections (Marathi only)
  sectionOneTitle   String @default("")
  sectionOneBody    String @default("")
  sectionTwoTitle   String @default("")
  sectionTwoBody    String @default("")
  sectionThreeTitle String @default("")
  sectionThreeBody  String @default("")
  stats       Json   // Array of statistics
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("village_info")
}

model HistoryCard {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  gradient    String
  icon        String
  order       Int    @default(0)
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("history_cards")
}

model TimelineItem {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  year        String
  title       String
  titleEn     String
  description String
  descriptionEn String
  side        String @default("left") // left, right
  order       Int    @default(0)
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("timeline_items")
}

model Announcement {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  date        String
  description String
  fullDescription String?
  image       String
  category    String
  priority    String // high, medium, low
  status      String // active, completed, upcoming
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("announcements")
}

model CulturalHeritage {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  image       String
  category    String
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cultural_heritage")
}

model HeroImage {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl    String
  title       String?
  description String?
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_images")
}

model HomepageSettings {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  mainHeading String @default("आमच्या गावात स्वागत आहे")
  mainHeadingEn String @default("Welcome to Our Village")
  subtitle    String @default("एकत्रित विकास, सामाजिक न्याय आणि सुशासनाच्या मार्गावर प्रगतीशील गाव")
  subtitleEn  String @default("A progressive village on the path of integrated development, social justice and good governance")
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("homepage_settings")
}

model Program {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  date        DateTime
  time        String?
  location    String?
  category    String?
  imageUrl    String?
  status      String @default("upcoming") // upcoming, ongoing, completed
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programs")
}

model Gallery {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  type        String // photo, video
  mediaUrl    String // URL to the image or video file
  category    String?
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery")
}

model Facility {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameEn      String
  description String
  descriptionEn String
  category    String
  location    String?
  contactInfo String?
  workingHours String?
  isActive    Boolean @default(true)
  imageUrl    String?
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("facilities")
}

model Contact {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  type        String // office, person, department
  name        String
  nameEn      String
  designation String?
  designationEn String?
  phone       String?
  email       String?
  address     String?
  addressEn   String?
  workingHours String?
  workingHoursEn String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contacts")
}

model OfficeDetails {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  address     String
  addressEn   String
  phone       String
  email       String
  workingHours String
  workingHoursEn String
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("office_details")
}

model TeamMember {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameEn      String
  designation String // सरपंच, उपसरपंच, ग्रामसेवक
  designationEn String // Sarpanch, Up-Sarpanch, Gramsevak
  phone       String
  email       String?
  imageUrl    String?
  isActive    Boolean @default(true)
  order       Int @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

model MapSettings {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  embedUrl    String // Google Maps embed URL
  latitude    String?
  longitude   String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("map_settings")
}

model IncomeExpense {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  type        String // income, expense
  title       String
  titleEn     String
  description String
  descriptionEn String
  amount      Float
  category    String
  date        DateTime
  receiptUrl  String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("income_expense")
}

model Department {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameEn      String
  description String
  descriptionEn String
  head        String
  headEn      String
  phone       String?
  email       String?
  address     String?
  addressEn   String?
  workingHours String?
  workingHoursEn String?
  services     String[]
  servicesEn   String[]
  imageUrl    String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model GovernmentScheme {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  titleEn     String
  description String
  descriptionEn String
  category    String
  eligibility String
  eligibilityEn String
  benefits    String
  benefitsEn  String
  documents   String
  documentsEn String
  applicationProcess String
  applicationProcessEn String
  contactInfo String
  contactInfoEn String
  website     String?
  imageUrl    String?
  startDate   String?
  endDate     String?
  isActive    Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("government_schemes")
}

model AdminUser {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  username  String @unique
  email     String @unique
  password  String
  role      String @default("admin") // super_admin, admin, editor
  isActive  Boolean @default(true)
  subdomainId String? @db.ObjectId
  subdomain Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model Subdomain {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  subdomain     String @unique
  villageName   String
  villageNameEn String
  contactPerson String
  email         String
  phone         String
  address       String
  description   String?
  districtId    String?
  districtName  String?
  subDistrictId String?
  subDistrictName String?
  villageId     String?
  villageNameLocal String?
  adminUsername String
  adminPassword String
  status        String @default("pending") // pending, active, suspended
  isActive      Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  adminUsers    AdminUser[]
  villageInfo   VillageInfo[]
  announcements Announcement[]
  culturalHeritage CulturalHeritage[]
  heroImages    HeroImage[]
  historyCards  HistoryCard[]
  timelineItems TimelineItem[]
  programs      Program[]
  gallery       Gallery[]
  facilities    Facility[]
  contacts      Contact[]
  officeDetails OfficeDetails[]
  teamMembers   TeamMember[]
  mapSettings   MapSettings[]
  incomeExpense IncomeExpense[]
  departments   Department[]
  governmentSchemes GovernmentScheme[]
  homepageSettings HomepageSettings[]
  footerContent   FooterContent[]

  @@map("subdomains")
}

model FooterContent {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  description String @default("एक प्रगतीशील, सुसंस्कृत आणि सामाजिक न्यायावर आधारित गावाची ओळख. सर्वांसाठी विकास आणि समृद्धी.")
  socialMedia Json   // Array of social media links: [{platform: "facebook", url: "https://...", icon: "Facebook"}]
  // Contact Information
  officeName  String @default("ग्रामपंचायत कार्यालय")
  address     String @default("गाव, तालुका, जिल्हा\nमहाराष्ट्र, भारत")
  phone       String @default("+91 12345 67890")
  email       String @default("info@grampanchayat.com")
  website     String @default("mahagp.in")
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("footer_content")
}

// Village Data Models
model District {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String @unique
  nameMarathi String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  subDistricts SubDistrict[]
  
  @@map("districts")
}

model SubDistrict {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String @unique
  nameMarathi String
  districtId  String @db.ObjectId
  district    District @relation(fields: [districtId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  villages Village[]
  
  @@map("sub_districts")
}

model Village {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  nameMarathi   String
  subDistrictId String @db.ObjectId
  subDistrict   SubDistrict @relation(fields: [subDistrictId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("villages")
}
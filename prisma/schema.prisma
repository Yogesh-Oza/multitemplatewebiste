  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  subdomainId String    @db.ObjectId
  subdomain   Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)
  kind        String // application | first_appeal | second_appeal
  labelMr     String
  labelEn     String
  url         String
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("rti_form_links")
}

// ===== GRAM SABHA (official record) =====

model GramSabhaMeeting {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  subdomainId     String    @db.ObjectId
  subdomain       Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)
  date            DateTime
  agenda          String
  agendaEn        String
  attendanceCount Int
  quorumMet       Boolean
  resolutions     Json
  documents       Json
  isActive        Boolean   @default(true)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([subdomainId, date])
  @@map("gram_sabha_meetings")
}

// ===== VILLAGE STATISTICS (year rows) =====

model VillageStatistics {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  subdomainId  String    @db.ObjectId
  subdomain    Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)
  year         Int
  population   Int
  voters       Int
  wards        Int
  schools      Int?
  anganwadis   Int?
  sourceMr     String?
  sourceEn     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([subdomainId, year])
  @@map("village_statistics")
}

// ===== CITIZEN SERVICES (DB-backed) =====

model CitizenService {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  subdomainId        String    @db.ObjectId
  subdomain          Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)
  titleMr            String
  titleEn            String
  descriptionMr      String
  descriptionEn      String
  category           String    @default("other") // birth, death, rts, other
  status             String    @default("available") // available, coming_soon, maintenance
  processingTimeMr   String    @default("")
  processingTimeEn   String    @default("")
  fees               Float     @default(0)
  requiredDocuments  Json      @default("[]")
  formUrl            String?
  applicationUrl     String?
  iconName           String    @default("FileText")
  colorClass         String    @default("bg-blue-500")
  onlineAvailable    Boolean   @default(true)
  order              Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("citizen_services")
}

// ===== ACTIVITY LOGGING SYSTEM =====

model ActivityLog {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  action          String // CREATE, UPDATE, DELETE
  model           String // Model name (e.g., "Announcement", "Program", "Gallery")
  modelId         String // ID of the affected record
  userId          String     @db.ObjectId
  user            AdminUser  @relation(fields: [userId], references: [id])
  userName        String
  userEmail       String
  subdomainId     String?    @db.ObjectId
  subdomain       Subdomain? @relation(fields: [subdomainId], references: [id])
  subdomainName   String? // Subdomain name (for quick access)
  villageName     String? // Village name
  districtName    String? // District name (for filtering)
  subDistrictName String? // Sub-district name (for filtering)
  description     String // Human-readable description
  ipAddress       String? // Optional IP address
  createdAt       DateTime   @default(now())

  @@index([userId])
  @@index([subdomainId])
  @@index([createdAt])
  @@index([action])
  @@index([model])
  @@index([districtName, subDistrictName, createdAt])
  @@map("activity_logs")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model VillageInfo {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  title                 String
  titleEn               String
  description           String
  descriptionEn         String
  // Village branding
  villageLogo           String? // Village logo URL
  villageName           String? // Custom village name for header
  villageNameEn         String? // Custom village name in English
  // Government branding strip (village-specific, overrides defaults)
  satyamevJayateLogoUrl String     @default("/images/gov-logos/satyamev_jayate_logo.png")
  digitalIndiaLogoUrl   String     @default("/images/gov-logos/digital-india.png")
  govDeptText           String     @default("शासन महाराष्ट्र • ग्रामीण विकास विभाग")
  officialSiteText      String     @default("अधिकृत ग्रामपंचायत संकेतस्थळ")
  // Additional dynamic sections (Marathi only)
  sectionOneTitle       String     @default("")
  sectionOneBody        String     @default("")
  sectionTwoTitle       String     @default("")
  sectionTwoBody        String     @default("")
  sectionThreeTitle     String     @default("")
  sectionThreeBody      String     @default("")
  welcomeVideo          Json?
  stats                 Json // Array of statistics
  subdomainId           String?    @db.ObjectId
  subdomain             Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("village_info")
}

model HistoryCard {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  titleEn       String
  description   String
  descriptionEn String
  gradient      String
  icon          String
  order         Int        @default(0)
  isActive      Boolean    @default(true)
  subdomainId   String?    @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("history_cards")
}

model TimelineItem {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  year          String
  title         String
  titleEn       String
  description   String
  descriptionEn String
  imageUrl      String?
  side          String     @default("left") // left, right
  order         Int        @default(0)
  isActive      Boolean    @default(true)
  subdomainId   String?    @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("timeline_items")
}

model Announcement {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  date            String
  description     String
  fullDescription String?
  image           String
  category        String
  priority        String // high, medium, low
  status          String // active, completed, upcoming
  isActive        Boolean    @default(true)
  order           Int        @default(0)
  subdomainId     String?    @db.ObjectId
  subdomain       Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("announcements")
}

model CulturalHeritage {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  titleEn       String
  description   String
  descriptionEn String
  image         String
  category      String
  isActive      Boolean    @default(true)
  order         Int        @default(0)
  subdomainId   String?    @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("cultural_heritage")
}

model HeroImage {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl    String
  title       String?
  description String?
  isActive    Boolean    @default(true)
  order       Int        @default(0)
  subdomainId String?    @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("hero_images")
}

model HomepageSettings {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  mainHeading   String     @default("आमच्या गावात स्वागत आहे")
  mainHeadingEn String     @default("Welcome to Our Village")
  subtitle      String     @default("एकत्रित विकास, सामाजिक न्याय आणि सुशासनाच्या मार्गावर प्रगतीशील गाव")
  subtitleEn    String     @default("A progressive village on the path of integrated development, social justice and good governance")
  isActive      Boolean    @default(true)
  subdomainId   String?    @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("homepage_settings")
}

model Program {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  titleEn       String
  description   String
  descriptionEn String
  date          DateTime
  time          String?
  location      String?
  category      String?
  imageUrl      String?
  status        String     @default("upcoming") // upcoming, ongoing, completed
  subdomainId   String?    @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("programs")
}

model Gallery {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  titleEn       String
  description   String
  descriptionEn String
  type          String // photo, video
  mediaUrl      String // URL to the image or video file
  category      String?
  isActive      Boolean    @default(true)
  order         Int        @default(0)
  subdomainId   String?    @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("gallery")
}

model Facility {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  nameEn          String
  description     String
  descriptionEn   String
  category        String
  location        String?
  contactInfo     String?
  workingHours    String?
  isActive        Boolean    @default(true)
  imageUrl        String?
  // GIS fields
  type            String?    // water, sanitation, road, school, health, library, playground, bus_stop, other
  status          String?    // operational, maintenance, non-functional
  statusEn        String?
  latitude        Float?
  longitude       Float?
  services        Json?      // Array of strings
  capacity        String?
  lastMaintenance String?
  subdomainId     String?    @db.ObjectId
  subdomain       Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("facilities")
}

model Contact {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  type           String // office, person, department
  name           String
  nameEn         String
  designation    String?
  designationEn  String?
  phone          String?
  email          String?
  address        String?
  addressEn      String?
  workingHours   String?
  workingHoursEn String?
  isActive       Boolean    @default(true)
  subdomainId    String?    @db.ObjectId
  subdomain      Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("contacts")
}

model OfficeDetails {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  address          String
  addressEn        String
  phone            String
  email            String
  workingHours     String
  workingHoursEn   String
  importantNotice  String?
  importantNoticeEn String?
  isActive         Boolean    @default(true)
  subdomainId      String?    @db.ObjectId
  subdomain        Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("office_details")
}

model Role {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  title           String     // e.g., "सरपंच"
  titleEn         String     // e.g., "Sarpanch"
  description     String
  responsibilities Json      // Array of responsibility strings
  icon            String     // Icon name (Users, Shield, FileText, Home)
  color           String     // Gradient color class
  order           Int        @default(0)
  isActive        Boolean    @default(true)
  subdomainId     String?    @db.ObjectId
  subdomain       Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("roles")
}

model EmergencyContact {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     // e.g., "पोलीस"
  nameEn      String     // e.g., "Police"
  phone       String     // e.g., "100 / +91 12345 11111"
  description String
  icon        String     // Icon name (Shield, Stethoscope, Flame, etc.)
  color       String     // Gradient color class
  priority    String     // "high" | "medium" | "low"
  category    String     // Category in Marathi
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  subdomainId String?    @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("emergency_contacts")
}

model TeamMember {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  nameEn        String
  designation   String // सरपंच, उपसरपंच, ग्रामसेवक
  designationEn String // Sarpanch, Up-Sarpanch, Gramsevak
  phone         String
  email         String?
  imageUrl      String?
  isActive      Boolean    @default(true)
  order         Int        @default(0)
  subdomainId   String?    @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("team_members")
}

model Leader {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  role        String // मा. मुख्यमंत्री, मा. उपमुख्यमंत्री, etc.
  roleEn      String // Hon'ble Chief Minister, etc.
  imageUrl    String
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  subdomainId String?    @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("leaders")
}

model MapSettings {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  embedUrl    String // Google Maps embed URL
  latitude    String?
  longitude   String?
  isActive    Boolean    @default(true)
  subdomainId String?    @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("map_settings")
}

model IncomeExpense {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  type          String // income, expense
  title         String
  titleEn       String
  description   String
  descriptionEn String
  amount        Float
  category      String
  date          DateTime
  receiptUrl    String?
  isActive      Boolean    @default(true)
  subdomainId   String?    @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("income_expense")
}

model Department {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  nameEn         String
  description    String
  descriptionEn  String
  head           String
  headEn         String
  phone          String?
  email          String?
  address        String?
  addressEn      String?
  workingHours   String?
  workingHoursEn String?
  services       String[]
  servicesEn     String[]
  imageUrl       String?
  isActive       Boolean    @default(true)
  subdomainId    String?    @db.ObjectId
  subdomain      Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("departments")
}

model GovernmentScheme {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId
  title                String
  titleEn              String
  description          String
  descriptionEn        String
  category             String
  eligibility          String
  eligibilityEn        String
  benefits             String
  benefitsEn           String
  documents            String
  documentsEn          String
  applicationProcess   String
  applicationProcessEn String
  contactInfo          String
  contactInfoEn        String
  website              String?
  imageUrl             String?
  startDate            String?
  endDate              String?
  isActive             Boolean    @default(true)
  subdomainId          String?    @db.ObjectId
  subdomain            Subdomain? @relation(fields: [subdomainId], references: [id])
  linkedProjects       Project[]  @relation("ProjectLinkedScheme")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  contactOfficeName     String?
  contactOfficeNameEn   String?
  contactAddress        String?
  contactAddressEn      String?
  contactPhone          String?
  contactOfficeHours    String?
  contactOfficeHoursEn  String?

  @@map("government_schemes")
}

model ApplicationProcessConfig {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  steps              Json       // Array of step objects
  requiredDocuments  Json       // Array of document objects
  applicationFormUrl String?
  sampleFormUrl      String?
  isActive           Boolean    @default(true)
  subdomainId       String?    @db.ObjectId
  subdomain         Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("application_process_configs")
}

model BeneficiaryStory {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nameEn      String
  age         Int
  scheme      String
  schemeEn    String
  story       String
  storyEn     String
  impact      String
  impactEn    String
  beforeImage String
  afterImage  String
  location    String
  locationEn  String
  date        String
  benefits    Json       // Array of strings
  rating      Int        @default(5)
  isStar      Boolean    @default(false)
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  subdomainId String?    @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("beneficiary_stories")
}

model WardCoverageData {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  wardNumber         String
  wardName           String
  wardNameEn         String
  totalHouseholds    Int
  beneficiaries      Int
  coveragePercentage Float
  schemes            Json       // Array of scheme objects
  lastUpdated        String
  order              Int        @default(0)
  isActive           Boolean    @default(true)
  subdomainId        String?    @db.ObjectId
  subdomain          Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@map("ward_coverage_data")
}

model WaterSanitationSnapshot {
  id                              String                     @id @default(auto()) @map("_id") @db.ObjectId
  sectionTitle                    String
  sectionTitleEn                  String
  sectionSubtitle                 String
  sectionSubtitleEn               String
  waterInfoTitle                  String
  waterInfoTitleEn                String
  waterConnectionsActive          Int
  waterConnectionsTotal           Int
  waterSupplyDuration             String
  waterSupplyDurationLabel        String
  waterSupplyDurationLabelEn      String
  waterSupplyFrequency            String
  waterSupplyFrequencyEn          String
  waterStorageCapacityValue       String
  waterStorageCapacityUnit        String
  waterStorageCapacityLabel       String
  waterStorageCapacityLabelEn     String
  waterQualityStatus              String
  waterQualityStatusEn            String
  waterQualityUpdatedOn           String
  sanitationInfoTitle             String
  sanitationInfoTitleEn           String
  sanitationFunctionalToilets     Int
  sanitationTotalToilets          Int
  sanitationPublicToilets         Int
  sanitationPublicToiletsLabel    String
  sanitationPublicToiletsLabelEn  String
  wasteCollectionStatus           String
  wasteCollectionStatusEn         String
  drainageStatus                  String
  drainageStatusEn                String
  waterTreatmentStatus            String
  waterTreatmentStatusEn          String
  issueTitle                      String
  issueTitleEn                    String
  issueDescription                String
  issueDescriptionEn              String
  emergencyTitle                  String
  emergencyTitleEn                String
  issueContactLabel               String
  issueContactLabelEn             String

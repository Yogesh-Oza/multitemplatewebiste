  facilities                      WaterSanitationFacility[]  @relation("SnapshotFacilities")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt

  @@map("water_sanitation_snapshots")
}

model WaterSanitationFacility {
  id               String                    @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  titleEn          String
  category         String
  status           String
  statusEn         String
  location         String
  locationEn       String
  capacity         String
  capacityEn       String
  updatedOn        String
  contactNumber    String
  contactLabel     String
  contactLabelEn   String
  actionLabel      String
  actionLabelEn    String
  order            Int                       @default(0)
  isActive         Boolean                   @default(true)
  snapshotId       String?                   @db.ObjectId
  snapshot         WaterSanitationSnapshot?  @relation("SnapshotFacilities", fields: [snapshotId], references: [id])
  subdomainId      String?                   @db.ObjectId
  subdomain        Subdomain?                @relation(fields: [subdomainId], references: [id])
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@map("water_sanitation_facilities")
}

model RoadsLightingSnapshot {
  id                        String                  @id @default(auto()) @map("_id") @db.ObjectId
  // Section titles
  sectionTitle              String
  sectionTitleEn            String
  sectionSubtitle           String
  sectionSubtitleEn         String
  // Roads data
  roadsInfoTitle            String
  roadsInfoTitleEn          String
  roadsTotalLength          Float
  roadsPavedLength          Float
  roadsUnpavedLength        Float
  roadsCondition            String // excellent, good, fair, poor
  roadsConditionEn          String
  roadsLastMaintenance      String
  roadsUpcomingWork         Json // Array of strings
  // Street lighting data
  lightingInfoTitle         String
  lightingInfoTitleEn       String
  lightingTotalLights       Int
  lightingFunctionalLights  Int
  lightingLedLights         Int
  lightingTraditionalLights Int
  lightingWorkingHours      String
  lightingLastMaintenance   String
  lightingEnergySource      String // grid, solar, hybrid
  lightingEnergySourceEn    String
  // Issue contact section
  issueTitle                String
  issueTitleEn              String
  issueDescription          String
  issueDescriptionEn        String
  issueContactLabel         String
  issueContactLabelEn       String
  issueContactNumber        String
  issueActionLabel          String
  issueActionLabelEn        String
  issueActionLabel2         String? // Second action button (e.g., "तक्रार नोंदवा")
  issueActionLabel2En       String?
  isActive                  Boolean                 @default(true)
  subdomainId               String?                 @db.ObjectId
  subdomain                 Subdomain?              @relation(fields: [subdomainId], references: [id])
  facilities                RoadsLightingFacility[] @relation("SnapshotFacilities")
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@map("roads_lighting_snapshots")
}

model RoadsLightingFacility {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  titleEn          String
  type             String // road, bridge, streetlight, traffic
  status           String // operational, maintenance, non-functional
  statusEn         String
  location         String
  locationEn       String
  length           String? // Optional, for roads
  capacity         String? // Optional, for bridges/lights
  lastMaintenance  String
  contactNumber    String
  contactLabel     String
  contactLabelEn   String
  actionLabel      String
  actionLabelEn    String
  order            Int                     @default(0)
  isActive         Boolean                 @default(true)
  snapshotId       String?                 @db.ObjectId
  snapshot         RoadsLightingSnapshot?  @relation("SnapshotFacilities", fields: [snapshotId], references: [id])
  subdomainId      String?                 @db.ObjectId
  subdomain        Subdomain?              @relation(fields: [subdomainId], references: [id])
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@map("roads_lighting_facilities")
}


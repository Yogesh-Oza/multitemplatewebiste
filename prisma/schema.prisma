  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("government_resolutions")
}

model Project {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  titleEn       String
  description   String
  descriptionEn String
  startDate     DateTime
  endDate       DateTime?
  status        String @default("upcoming") // upcoming, ongoing, completed
  budget        Float?
  photosBefore  String[] // Array of image URLs
  photosAfter   String[] // Array of image URLs
  impactMetrics Json     // Array of metrics: [{label: "Families Benefited", value: 150}]
  category      String
  categoryEn    String
  isFeatured    Boolean @default(false)
  order         Int    @default(0)
  subdomainId   String? @db.ObjectId
  subdomain     Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("projects")
}

model Complaint {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  type        String // grievance, suggestion, complaint
  subject     String
  description String
  citizenName String
  phone       String
  email       String?
  status      String @default("pending") // pending, in_progress, resolved, closed
  priority    String @default("medium") // low, medium, high, urgent
  trackingCode String @unique
  escalatedTo String?
  history     Json   // Array of status updates: [{status: "pending", date: "2024-01-01", note: "Received"}]
  attachments String[] // Array of file URLs
  isPublic    Boolean @default(false)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("complaints")
}

model Employment {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  type        String // job, tender, contract, training
  title       String
  titleEn     String
  organization String
  organizationEn String
  location    String
  locationEn  String
  lastDate    DateTime?
  link        String?
  description String
  descriptionEn String
  category    String
  categoryEn  String
  isActive    Boolean @default(true)
  order       Int    @default(0)
  subdomainId String? @db.ObjectId
  subdomain   Subdomain? @relation(fields: [subdomainId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("employment")
}

model EducationItem {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  type        String // school, scholarship, program, award
  title       String
  titleEn     String
  description String
  descriptionEn String
  links       String[] // Array of URLs
  images      String[] // Array of image URLs
  date        DateTime?
  tags        String[] // Array of tags
  isActive    Boolean @default(true)
